---
import SiteFooter from '../components/global/SiteFooter.astro';
import YandexMetrika from '../components/global/YandexMetrika.astro';
import { siteConfig, toPublicUrl } from '../config/site';
import {
  buildStructuredData,
  serializeStructuredData,
  type PageType,
  type StructuredDataNode,
} from '../lib/structured-data';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pageType?: PageType;
  structuredData?: StructuredDataNode[];
  canonicalPath?: string | null;
  socialImagePath?: string;
  socialImageAlt?: string;
  robots?: string;
}

const {
  title = 'SinijMir Studio — разработка цифровых продуктов',
  description = 'Мобильные приложения, Telegram-боты, AI-интеграции и автоматизация — от идеи до запуска.',
  pageType = 'WebPage',
  structuredData = [],
  canonicalPath = Astro.url.pathname,
  socialImagePath = siteConfig.socialImagePath,
  socialImageAlt = siteConfig.socialImageAlt,
  robots = 'index, follow',
} = Astro.props;

const canonicalUrl = canonicalPath ? toPublicUrl(canonicalPath) : null;
const socialImageUrl = toPublicUrl(socialImagePath);
const baseUrl = import.meta.env.BASE_URL;
const faviconUrl = `${baseUrl}${siteConfig.faviconPath.replace(/^\//, '')}?v=3`;
const appleTouchIconUrl = `${baseUrl}${siteConfig.appleTouchIconPath.replace(/^\//, '')}?v=3`;
const yandexVerification = import.meta.env.PUBLIC_YANDEX_VERIFICATION?.trim();
const jsonLd = canonicalPath
  ? serializeStructuredData(
      buildStructuredData({
        title,
        description,
        path: canonicalPath,
        pageType,
        extra: structuredData,
      }),
    )
  : null;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/png" sizes="64x64" href={faviconUrl} />
    <link rel="apple-touch-icon" sizes="160x160" href={appleTouchIconUrl} />
    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
  </head>
  <body id="top">
    {import.meta.env.PROD && <YandexMetrika />}
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    <slot />
    <SiteFooter />
  </body>
</html>
