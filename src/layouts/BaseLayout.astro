---
import SiteFooter from '../components/global/SiteFooter.astro';
import { toPublicUrl } from '../config/site';
import {
  buildStructuredData,
  serializeStructuredData,
  type PageType,
  type StructuredDataNode,
} from '../lib/structured-data';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  pageType?: PageType;
  structuredData?: StructuredDataNode[];
  canonicalPath?: string;
}

const {
  title = 'SinijMir Studio — разработка цифровых продуктов',
  description = 'Мобильные приложения, Telegram-боты, AI-интеграции и автоматизация — от идеи до запуска.',
  pageType = 'WebPage',
  structuredData = [],
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonicalUrl = toPublicUrl(canonicalPath);
const jsonLd = serializeStructuredData(
  buildStructuredData({
    title,
    description,
    path: canonicalPath,
    pageType,
    extra: structuredData,
  }),
);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070d" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body id="top">
    <slot />
    <SiteFooter />
  </body>
</html>
