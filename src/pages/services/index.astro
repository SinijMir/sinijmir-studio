---
import SiteHeader from '../../components/global/SiteHeader.astro';
import ServiceDetailCard from '../../components/services/ServiceDetailCard.astro';
import { toPublicUrl } from '../../config/site';
import { services } from '../../data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';

const contactHref = `${import.meta.env.BASE_URL}contact/`;
const organizationId = `${toPublicUrl('/')}#organization`;
const serviceCatalog = {
  '@type': 'ItemList',
  '@id': `${toPublicUrl('/services/')}#services`,
  name: 'Услуги SinijMir Studio',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      description: service.description,
      provider: { '@id': organizationId },
    },
  })),
};
---

<BaseLayout
  title="Услуги — SinijMir Studio"
  description="Мобильные приложения, AI-интеграции, Telegram-боты, backend, запуск и поддержка цифровых продуктов."
  pageType="CollectionPage"
  structuredData={[serviceCatalog]}
>
  <div class="header-shell">
    <SiteHeader />
  </div>

  <main>
    <section class="services-hero" aria-labelledby="services-page-title">
      <div class="section-inner">
        <p class="eyebrow">Services / SinijMir Studio</p>
        <div class="hero-grid">
          <h1 id="services-page-title">От идеи и архитектуры — до релиза и развития.</h1>
          <p>
            Подбираем формат работы под задачу: новый MVP, отдельная интеграция, исправление существующего приложения или
            подготовка следующего релиза.
          </p>
        </div>
      </div>
    </section>

    <section class="services-list" aria-label="Направления разработки">
      <div class="section-inner services-grid">
        {services.map((service) => <ServiceDetailCard service={service} />)}
      </div>
    </section>

    <section class="start-section" aria-labelledby="start-title">
      <div class="section-inner">
        <div class="start-copy">
          <p>Как начинается работа</p>
          <h2 id="start-title">Сначала определяем результат, затем объём и технологии.</h2>
        </div>

        <ol>
          <li><span>01</span><p>Вы описываете задачу и текущую ситуацию.</p></li>
          <li><span>02</span><p>Мы уточняем ограничения и предлагаем следующий этап.</p></li>
          <li><span>03</span><p>Согласовываем границы работы до начала реализации.</p></li>
        </ol>

        <a href={contactHref}>Перейти к контактам <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .header-shell,
  .section-inner {
    width: min(calc(100% - 48px), var(--container));
    margin: 0 auto;
  }

  .services-hero {
    padding: clamp(76px, 11vw, 148px) 0;
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 82% 28%, rgba(33, 136, 255, 0.16), transparent 30rem),
      linear-gradient(180deg, rgba(10, 15, 26, 0.7), rgba(5, 7, 13, 0.96));
  }

  .eyebrow,
  .start-copy > p {
    margin: 0 0 26px;
    color: var(--color-accent-bright);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.55fr);
    gap: clamp(40px, 8vw, 116px);
    align-items: end;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3.4rem, 8vw, 7rem);
    font-weight: 570;
    letter-spacing: -0.078em;
    line-height: 0.94;
  }

  .hero-grid > p {
    margin: 0 0 6px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.78;
  }

  .services-list {
    padding: clamp(76px, 10vw, 132px) 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .start-section {
    padding: clamp(82px, 11vw, 148px) 0;
    border-top: 1px solid var(--color-border);
    background: rgba(8, 12, 21, 0.58);
  }

  .start-copy {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) minmax(0, 1.65fr);
    gap: clamp(38px, 8vw, 120px);
  }

  .start-copy h2 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.6rem);
    font-weight: 570;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  ol {
    margin: clamp(52px, 8vw, 92px) 0 34px;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 24px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border);
  }

  li span {
    color: var(--color-accent-bright);
    font-size: 0.64rem;
    font-weight: 750;
  }

  li p {
    margin: 0;
    color: #c4d0df;
    font-size: 0.86rem;
  }

  .start-section a {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .start-section a span {
    color: var(--color-accent-bright);
    font-size: 1rem;
  }

  .start-section a:hover,
  .start-section a:focus-visible {
    color: var(--color-accent-bright);
  }

  @media (max-width: 820px) {
    .hero-grid,
    .start-copy {
      grid-template-columns: 1fr;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .header-shell,
    .section-inner {
      width: min(calc(100% - 32px), var(--container));
    }
  }
</style>
