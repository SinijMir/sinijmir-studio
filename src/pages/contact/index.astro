---
import SiteHeader from '../../components/global/SiteHeader.astro';
import { projectBriefPrompts, telegramContact } from '../../config/contact';
import BaseLayout from '../../layouts/BaseLayout.astro';

const servicesHref = `${import.meta.env.BASE_URL}services/`;
---

<BaseLayout
  title="Контакты — SinijMir Studio"
  description="Связаться с SinijMir Studio и обсудить мобильное приложение, Telegram-бота, AI-интеграцию или поддержку продукта."
>
  <div class="header-shell">
    <SiteHeader />
  </div>

  <main>
    <section class="contact-hero" aria-labelledby="contact-page-title">
      <div class="section-inner hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Contact / Start a project</p>
          <h1 id="contact-page-title">Расскажите, какой результат вам нужен.</h1>
          <p>
            Для первого разговора достаточно идеи, проблемы или ссылки на существующий продукт. Полное техническое задание
            можно сформировать позже.
          </p>
        </div>

        <aside class="telegram-card" aria-label="Контакт в Telegram">
          <span class="channel-label">Основной канал</span>
          <strong>{telegramContact.handle}</strong>
          <p>Личные сообщения в Telegram для первого обсуждения и уточнения задачи.</p>
          <a href={telegramContact.href} target="_blank" rel="noreferrer">
            Открыть Telegram
            <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>
    </section>

    <section class="brief-section" aria-labelledby="brief-title">
      <div class="section-inner brief-grid">
        <div class="brief-copy">
          <p class="eyebrow">01 / Brief</p>
          <h2 id="brief-title">Что полезно указать в первом сообщении.</h2>
          <p>Это ориентир, а не обязательная форма. Можно начать с одной фразы.</p>
        </div>

        <ol>
          {
            projectBriefPrompts.map((prompt, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{prompt}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="expectation-section" aria-labelledby="expectation-title">
      <div class="section-inner expectation-grid">
        <div>
          <p class="eyebrow">02 / Next step</p>
          <h2 id="expectation-title">Что произойдёт после сообщения.</h2>
        </div>
        <div class="expectation-list">
          <article><span>01</span><p>Уточним задачу и текущий контекст.</p></article>
          <article><span>02</span><p>Определим ближайший проверяемый этап.</p></article>
          <article><span>03</span><p>Согласуем границы до начала разработки.</p></article>
        </div>
        <a href={servicesHref}>Посмотреть направления работы <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .header-shell,
  .section-inner {
    width: min(calc(100% - 48px), var(--container));
    margin: 0 auto;
  }

  .contact-hero {
    padding: clamp(76px, 11vw, 148px) 0;
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 80% 32%, rgba(33, 136, 255, 0.18), transparent 30rem),
      linear-gradient(180deg, rgba(10, 15, 26, 0.7), rgba(5, 7, 13, 0.96));
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: clamp(46px, 9vw, 132px);
    align-items: end;
  }

  .eyebrow,
  .channel-label {
    margin: 0 0 24px;
    color: var(--color-accent-bright);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 860px;
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.2rem);
    font-weight: 570;
    letter-spacing: -0.08em;
    line-height: 0.92;
  }

  .hero-copy > p:last-child {
    max-width: 680px;
    margin: 30px 0 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.78;
  }

  .telegram-card {
    padding: clamp(28px, 4vw, 42px);
    border: 1px solid rgba(102, 179, 255, 0.32);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 82% 12%, rgba(75, 178, 255, 0.24), transparent 15rem),
      rgba(10, 25, 45, 0.88);
  }

  .telegram-card strong {
    display: block;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 610;
    letter-spacing: -0.045em;
  }

  .telegram-card p {
    margin: 26px 0 34px;
    color: #aebed1;
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .telegram-card a,
  .expectation-section > div > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .telegram-card a {
    padding: 15px 18px;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .brief-section,
  .expectation-section {
    padding: clamp(82px, 11vw, 148px) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .brief-grid,
  .expectation-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(48px, 9vw, 132px);
  }

  h2 {
    max-width: 620px;
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    font-weight: 570;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .brief-copy > p:last-child {
    max-width: 420px;
    margin: 24px 0 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  ol,
  .expectation-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  li,
  .expectation-list article {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 20px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border);
  }

  li span,
  .expectation-list span {
    color: var(--color-accent-bright);
    font-size: 0.63rem;
    font-weight: 750;
  }

  li p,
  .expectation-list p {
    margin: 0;
    color: #c1cedd;
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .expectation-section {
    background: rgba(8, 12, 21, 0.55);
  }

  .expectation-grid > a {
    grid-column: 2;
    max-width: 310px;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .expectation-grid > a span {
    color: var(--color-accent-bright);
    font-size: 1rem;
  }

  .telegram-card a:hover,
  .telegram-card a:focus-visible,
  .expectation-grid > a:hover,
  .expectation-grid > a:focus-visible {
    color: var(--color-accent-bright);
  }

  @media (max-width: 820px) {
    .hero-grid,
    .brief-grid,
    .expectation-grid {
      grid-template-columns: 1fr;
    }

    .expectation-grid > a {
      grid-column: 1;
    }
  }

  @media (max-width: 620px) {
    .header-shell,
    .section-inner {
      width: min(calc(100% - 32px), var(--container));
    }
  }
</style>
