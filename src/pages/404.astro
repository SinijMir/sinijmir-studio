---
import SiteHeader from '../components/global/SiteHeader.astro';
import { metrikaGoalGroups } from '../config/analytics';
import BaseLayout from '../layouts/BaseLayout.astro';

const homeHref = import.meta.env.BASE_URL;
const servicesHref = `${import.meta.env.BASE_URL}services/`;
const requestHref = `${import.meta.env.BASE_URL}request/#inquiry-form`;
---

<BaseLayout
  title="Страница не найдена — SinijMir Studio"
  description="Запрошенная страница не найдена. Перейдите на главную, к услугам или начните обсуждение проекта."
  canonicalPath={null}
  robots="noindex, follow"
>
  <div class="header-shell"><SiteHeader /></div>

  <main id="main-content" class="not-found" tabindex="-1">
    <div class="not-found__inner">
      <div class="not-found__code" aria-hidden="true">404</div>
      <div class="not-found__content">
        <p class="eyebrow">Page not found / SinijMir Studio</p>
        <h1>Такой страницы<br />здесь нет.</h1>
        <p class="lead">
          Возможно, адрес изменился или в нём есть ошибка. Выберите подходящий следующий шаг.
        </p>
        <nav aria-label="Переходы со страницы ошибки">
          <a class="primary" href={homeHref}>На главную <span aria-hidden="true">↗</span></a>
          <a href={servicesHref}>Услуги</a>
          <a href={requestHref} data-metrika-goals={metrikaGoalGroups.discussProject}>
            Обсудить проект
          </a>
        </nav>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .header-shell,
  .not-found__inner {
    width: min(calc(100% - 48px), var(--container));
    margin: 0 auto;
  }

  .not-found {
    min-height: 72vh;
    display: grid;
    place-items: center;
    padding: clamp(72px, 10vw, 140px) 0;
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 78% 34%, rgba(33, 136, 255, 0.17), transparent 28rem),
      linear-gradient(180deg, rgba(10, 15, 26, 0.7), rgba(5, 7, 13, 0.96));
  }

  .not-found__inner {
    display: grid;
    grid-template-columns: minmax(230px, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(48px, 10vw, 150px);
    align-items: center;
  }

  .not-found__code {
    color: rgba(102, 179, 255, 0.12);
    font-size: clamp(8rem, 22vw, 20rem);
    font-weight: 700;
    letter-spacing: -0.1em;
    line-height: 0.7;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: var(--color-accent-bright);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.4rem, 8vw, 7rem);
    font-weight: 570;
    letter-spacing: -0.078em;
    line-height: 0.94;
  }

  .lead {
    max-width: 620px;
    margin: 30px 0 0;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 38px;
  }

  nav a {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 14px 20px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    border-color: rgba(102, 179, 255, 0.58);
    color: var(--color-accent-bright);
  }

  nav .primary {
    border-color: transparent;
    color: #fff;
    background: var(--color-accent);
  }

  nav .primary:hover,
  nav .primary:focus-visible {
    color: #fff;
    background: var(--color-accent-hover);
  }

  @media (max-width: 760px) {
    .not-found__inner {
      grid-template-columns: 1fr;
    }

    .not-found__code {
      font-size: clamp(7rem, 36vw, 11rem);
    }
  }

  @media (max-width: 620px) {
    .header-shell,
    .not-found__inner {
      width: min(calc(100% - 32px), var(--container));
    }
  }
</style>
