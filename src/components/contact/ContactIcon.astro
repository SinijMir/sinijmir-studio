---
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Phone from '@lucide/astro/icons/phone';
import Send from '@lucide/astro/icons/send';
import type { ContactChannel } from '../../config/contact';

interface Props {
  type: ContactChannel['type'];
  size?: number;
}

const { type, size = 18 } = Astro.props;
---

<span class="contact-icon" aria-hidden="true">
  {type === 'phone' && <Phone size={size} stroke-width="1.8" />}
  {type === 'email' && <Mail size={size} stroke-width="1.8" />}
  {type === 'location' && <MapPin size={size} stroke-width="1.8" />}
  {type === 'messenger' && <Send size={size} stroke-width="1.8" />}
</span>

<style>
  .contact-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(132, 204, 255, 0.28);
    border-radius: 12px;
    color: var(--color-accent-bright);
    background: rgba(38, 132, 212, 0.1);
  }
</style>
