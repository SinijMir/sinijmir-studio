---
import {
  contactChannels,
  phoneContact,
  telegramContact,
} from '../../config/contact';
import ContactIcon from './ContactIcon.astro';

interface Props {
  telegramLabel?: string;
}

const { telegramLabel = telegramContact.buttonLabel } = Astro.props;
---

<div class="contact-options">
  <ul class="contact-details" aria-label="Контактные данные SinijMir Studio">
    {
      contactChannels.map((channel) => (
        <li>
          <a
            href={channel.href}
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noreferrer' : undefined}
            data-metrika-goals={channel.analyticsGoal}
          >
            <ContactIcon type={channel.type} />
            <span class="contact-copy">
              <small>{channel.service}</small>
              <strong>{channel.handle}</strong>
            </span>
            {channel.external && <span class="external" aria-hidden="true">↗</span>}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="contact-actions">
    <a
      class="action action-primary"
      href={telegramContact.href}
      target="_blank"
      rel="noreferrer"
      aria-label={`${telegramLabel} в Telegram`}
      data-metrika-goals={telegramContact.analyticsGoal}
    >
      {telegramLabel}
      <span aria-hidden="true">↗</span>
    </a>
    <a
      class="action action-secondary"
      href={phoneContact.href}
      aria-label={`Позвонить по номеру ${phoneContact.handle}`}
      data-metrika-goals={phoneContact.analyticsGoal}
    >
      {phoneContact.buttonLabel}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>

<style>
  .contact-options {
    margin-top: auto;
  }

  .contact-details {
    display: grid;
    gap: 8px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }

  .contact-details a {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 10px;
    border: 1px solid transparent;
    border-radius: 15px;
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease;
  }

  .contact-details a:hover {
    border-color: rgba(132, 204, 255, 0.22);
    background: rgba(35, 117, 190, 0.1);
  }

  .contact-copy {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  .contact-copy small {
    color: #8397af;
    font-size: 0.57rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .contact-copy strong {
    overflow-wrap: anywhere;
    color: #e8f2ff;
    font-size: 0.86rem;
    font-weight: 650;
  }

  .external {
    margin-left: auto;
    color: var(--color-accent-bright);
    font-size: 0.88rem;
  }

  .contact-actions {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(112px, 0.65fr);
    gap: 10px;
  }

  .action {
    min-height: 50px;
    padding: 14px 17px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .action-primary {
    background: var(--color-accent);
    box-shadow: 0 18px 54px rgba(33, 136, 255, 0.25);
  }

  .action-secondary {
    border-color: rgba(132, 204, 255, 0.36);
    background: rgba(8, 18, 33, 0.48);
  }

  .action:hover {
    transform: translateY(-2px);
  }

  .action-primary:hover {
    background: var(--color-accent-hover);
  }

  .action-secondary:hover {
    border-color: rgba(132, 204, 255, 0.68);
    background: rgba(25, 65, 104, 0.5);
  }

  .action:focus-visible,
  .contact-details a:focus-visible {
    outline: 3px solid rgba(132, 204, 255, 0.55);
    outline-offset: 4px;
  }

  @media (max-width: 520px) {
    .contact-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
