---
import { inquiryConfig } from '../../config/inquiry';
import { telegramContact } from '../../config/contact';
import '../../styles/inquiry-form.css';

const privacyHref = `${import.meta.env.BASE_URL}privacy/`;
---

<section class="inquiry-section" aria-labelledby="inquiry-title">
  <div class="inquiry-layout">
    <div class="inquiry-intro">
      <p class="eyebrow">Project request / Telegram</p>
      <h2 id="inquiry-title">Расскажите о задаче — мы свяжемся с вами.</h2>
      <p>
        Заявка поступит напрямую в закрытый Telegram-чат SinijMir Studio. Для первого ответа достаточно основных деталей.
      </p>
      <ul>
        <li>Без регистрации и личного кабинета</li>
        <li>Ответ по указанному номеру телефона</li>
        <li>Никаких рекламных рассылок</li>
      </ul>
      <p class="alternative">
        Удобнее написать самостоятельно? <a href={telegramContact.href} target="_blank" rel="noreferrer">Откройте Telegram ↗</a>
      </p>
    </div>

    <form class="inquiry-form" data-inquiry-form data-endpoint={inquiryConfig.endpoint}>
      <div class="field-row">
        <label>
          <span>Ваше имя <b aria-hidden="true">*</b></span>
          <input
            type="text"
            name="name"
            autocomplete="name"
            minlength="2"
            maxlength={inquiryConfig.limits.name}
            placeholder="Как к вам обращаться"
            required
          />
        </label>

        <label>
          <span>Телефон <b aria-hidden="true">*</b></span>
          <input
            type="tel"
            name="phone"
            autocomplete="tel"
            inputmode="tel"
            minlength="7"
            maxlength={inquiryConfig.limits.phone}
            placeholder="+7 (___) ___-__-__"
            required
          />
        </label>
      </div>

      <label>
        <span>Направление проекта</span>
        <select name="projectType">
          <option value="">Пока не определились</option>
          {inquiryConfig.projectTypes.map((projectType) => <option value={projectType}>{projectType}</option>)}
        </select>
      </label>

      <label>
        <span>Суть или цель проекта <b aria-hidden="true">*</b></span>
        <textarea
          name="message"
          minlength="10"
          maxlength={inquiryConfig.limits.message}
          rows="7"
          placeholder="Что нужно создать или улучшить? Какой результат вы хотите получить?"
          required
        ></textarea>
      </label>

      <label class="honeypot" aria-hidden="true">
        <span>Компания</span>
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>

      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>
          Я согласен(на) на обработку указанных данных в соответствии с
          <a href={privacyHref} target="_blank" rel="noreferrer">политикой обработки персональных данных</a>.
        </span>
      </label>

      <div class="form-footer">
        <button type="submit" data-submit-button>
          <span data-submit-label>Отправить заявку</span>
          <span aria-hidden="true">→</span>
        </button>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const buttonLabel = form.querySelector<HTMLElement>('[data-submit-label]');

    const setStatus = (message: string, state = '') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!button || !buttonLabel || form.dataset.submitting === 'true' || !form.reportValidity()) return;

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') ?? '').trim(),
        phone: String(formData.get('phone') ?? '').trim(),
        projectType: String(formData.get('projectType') ?? '').trim(),
        message: String(formData.get('message') ?? '').trim(),
        company: String(formData.get('company') ?? '').trim(),
        consent: formData.get('consent') === 'on',
      };
      const originalLabel = buttonLabel.textContent ?? 'Отправить заявку';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 35000);

      form.dataset.submitting = 'true';
      button.disabled = true;
      buttonLabel.textContent = 'Отправляем…';
      setStatus('Передаём заявку в SinijMir Studio…');

      try {
        const response = await fetch(form.dataset.endpoint ?? '', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.ok) throw new Error(result.error || 'Не удалось отправить заявку');

        form.reset();
        const requestNote = result.requestId ? ` Номер заявки: ${result.requestId}.` : '';
        setStatus(`Заявка отправлена.${requestNote} Мы свяжемся с вами.`, 'success');
      } catch (error) {
        const timedOut = error instanceof DOMException && error.name === 'AbortError';
        const message = timedOut ? 'Сервис не ответил вовремя' : 'Не удалось отправить заявку';
        setStatus(`${message}. Попробуйте ещё раз или напишите нам в Telegram.`, 'error');
      } finally {
        window.clearTimeout(timeout);
        delete form.dataset.submitting;
        button.disabled = false;
        buttonLabel.textContent = originalLabel;
      }
    });
  }
</script>