---
const capabilities = [
  {
    number: '01',
    title: 'Mobile products',
    text: 'Flutter-приложения для Android и iOS — от MVP до публикации и поддержки.',
  },
  {
    number: '02',
    title: 'AI systems',
    text: 'Интеграции OpenAI и Gemini, интеллектуальные функции и автоматизация процессов.',
  },
  {
    number: '03',
    title: 'Bots & API',
    text: 'Telegram-боты, REST API и надежная серверная логика для цифровых сервисов.',
  },
];
---

<div class="capabilities" id="capabilities" aria-label="Направления студии">
  <div class="capabilities-intro">
    <span>Capabilities</span>
    <span>2026</span>
  </div>

  {capabilities.map((item) => (
    <article class="capability-card">
      <span class="capability-number">{item.number}</span>
      <div>
        <h2>{item.title}</h2>
        <p>{item.text}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .capabilities {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(20, 30, 50, 0.8), rgba(8, 11, 20, 0.84));
    box-shadow: var(--shadow-glow);
    backdrop-filter: blur(22px);
  }

  .capabilities::before {
    position: absolute;
    inset: -180px auto auto -120px;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(33, 136, 255, 0.12);
    filter: blur(10px);
    content: '';
    pointer-events: none;
  }

  .capabilities-intro {
    display: flex;
    justify-content: space-between;
    padding: 23px 26px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .capability-card {
    position: relative;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 18px;
    padding: 25px 26px;
    border-bottom: 1px solid var(--color-border);
    transition: background 180ms ease;
  }

  .capability-card:last-child {
    border-bottom: 0;
  }

  .capability-card:hover {
    background: var(--color-accent-soft);
  }

  .capability-number {
    padding-top: 3px;
    color: var(--color-accent-bright);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .capability-card h2 {
    margin: 0 0 8px;
    font-size: 1rem;
    font-weight: 630;
    letter-spacing: -0.02em;
  }

  .capability-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .capabilities {
      max-width: 640px;
    }
  }

  @media (max-width: 560px) {
    .capability-card {
      padding: 22px 20px;
    }

    .capabilities-intro {
      padding: 20px;
    }
  }
</style>
