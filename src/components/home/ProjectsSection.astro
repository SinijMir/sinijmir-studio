---
import type { ProjectEntry } from '../../lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
---

<section class="projects-section" id="projects" aria-labelledby="projects-title">
  <div class="projects-inner">
    <div class="section-intro">
      <p class="section-label"><span>03</span> / Projects</p>

      <div class="intro-copy">
        <h2 id="projects-title">
          Собственные продукты.<br />
          От идеи до <em>работающей системы.</em>
        </h2>
        <p>
          На проектах студии мы развиваем мобильную разработку, серверные решения и AI-интеграции как единую продуктовую систему.
          Каждый следующий этап опирается на реальный опыт предыдущего.
        </p>
      </div>
    </div>

    <div class="projects-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>

    <div class="projects-note">
      <span>Портфолио растёт вместе со студией</span>
      <p>Новые проекты и подробные кейсы будут появляться по мере развития и релизов.</p>
    </div>
  </div>
</section>

<style>
  .projects-section {
    scroll-margin-top: 24px;
    padding: clamp(92px, 13vw, 172px) 0;
    border-top: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 84% 18%, rgba(37, 119, 255, 0.12), transparent 30rem),
      linear-gradient(180deg, rgba(8, 12, 21, 0.72), rgba(5, 7, 13, 0.96));
  }

  .projects-inner {
    width: min(calc(100% - 48px), var(--container));
    margin: 0 auto;
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(140px, 0.35fr) minmax(0, 1.65fr);
    gap: clamp(34px, 8vw, 120px);
    margin-bottom: clamp(52px, 8vw, 96px);
  }

  .section-label {
    margin: 8px 0 0;
    color: #6f7c91;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-label span {
    color: var(--color-accent-bright);
  }

  .intro-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(250px, 0.55fr);
    gap: clamp(32px, 5vw, 74px);
    align-items: end;
  }

  h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 570;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  h2 em {
    color: var(--color-accent-bright);
    font-style: normal;
  }

  .intro-copy > p {
    margin: 0 0 4px;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.75;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .projects-note {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-top: 30px;
    padding: 22px 4px 0;
    border-top: 1px solid var(--color-border);
  }

  .projects-note span {
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .projects-note p {
    margin: 0;
    color: #6f7c91;
    font-size: 0.75rem;
  }

  @media (max-width: 900px) {
    .section-intro,
    .intro-copy {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .intro-copy > p {
      max-width: 620px;
    }
  }

  @media (max-width: 680px) {
    .projects-inner {
      width: min(calc(100% - 32px), var(--container));
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .projects-note {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
