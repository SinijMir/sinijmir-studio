---
const technologies = [
  'Flutter',
  'Android / iOS',
  'Telegram Bots',
  'AI integrations',
  'REST API',
];
---

<footer class="technology-line" aria-label="Технологии студии">
  {technologies.map((technology) => <span>{technology}</span>)}
</footer>

<style>
  .technology-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 28px;
    padding-top: 22px;
    border-top: 1px solid var(--color-border);
    color: #6f7c91;
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .technology-line {
      justify-content: flex-start;
    }
  }
</style>
