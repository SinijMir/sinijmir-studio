---
import CapabilitiesPanel from './CapabilitiesPanel.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span>AI-powered development</span> / Работаем без границ</p>
    <h1 id="hero-title">
      Создаём продукты,<br />
      которые <em>двигают</em><br />
      идеи вперёд.
    </h1>
    <p class="hero-description">
      Объединяем мобильную разработку, AI-инструменты и автоматизацию,
      чтобы быстрее превращать сильные идеи в работающие цифровые продукты.
    </p>

    <div class="hero-actions">
      <a class="hero-action primary-action" href="/request/#inquiry-form">
        Обсудить проект
        <span aria-hidden="true">↗</span>
      </a>
      <a class="hero-action secondary-action" href="#services">
        Что мы создаём
        <span aria-hidden="true">↘</span>
      </a>
    </div>
  </div>

  <CapabilitiesPanel />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    gap: clamp(48px, 8vw, 112px);
    align-items: center;
    padding: clamp(68px, 10vh, 118px) 0;
  }

  .eyebrow {
    margin: 0 0 24px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow span {
    color: var(--color-accent-bright);
  }

  h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(3.25rem, 7.1vw, 6.7rem);
    font-weight: 580;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  h1 em {
    color: var(--color-accent-bright);
    font-style: normal;
    text-shadow: 0 0 46px rgba(33, 136, 255, 0.3);
  }

  .hero-description {
    max-width: 650px;
    margin: 32px 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 38px;
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 58px;
    padding: 15px 18px 15px 21px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .primary-action {
    background: var(--color-accent);
    box-shadow: 0 16px 48px rgba(33, 136, 255, 0.25);
  }

  .secondary-action {
    border-color: rgba(132, 204, 255, 0.36);
    background: rgba(8, 18, 33, 0.48);
  }

  .hero-action:hover {
    transform: translateY(-2px);
  }

  .primary-action:hover {
    background: var(--color-accent-hover);
  }

  .secondary-action:hover {
    border-color: rgba(132, 204, 255, 0.68);
    background: rgba(25, 65, 104, 0.5);
  }

  .hero-action:focus-visible {
    outline: 3px solid rgba(102, 179, 255, 0.44);
    outline-offset: 4px;
  }

  .hero-action span {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .secondary-action span {
    background: rgba(132, 204, 255, 0.12);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 52px;
      padding: 72px 0 62px;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 58px;
    }

    h1 {
      font-size: clamp(3rem, 16vw, 4.4rem);
    }

    .hero-description {
      margin-top: 26px;
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    .hero-action {
      width: 100%;
    }
  }
</style>
