---
import ContactIcon from '../contact/ContactIcon.astro';
import { contactChannels } from '../../config/contact';
---

<div class="footer-contact-links" aria-label="Контакты SinijMir Studio">
  {
    contactChannels.map((channel) => (
      <a
        href={channel.href}
        target={channel.external ? '_blank' : undefined}
        rel={channel.external ? 'noreferrer' : undefined}
        aria-label={`${channel.service}: ${channel.handle}`}
      >
        <ContactIcon type={channel.type} size={16} />
        <span>{channel.handle}</span>
        {channel.external && <span class="external" aria-hidden="true">↗</span>}
      </a>
    ))
  }
</div>
<p>Основной канал — Telegram. Также можно позвонить или написать на электронную почту.</p>

<style>
  .footer-contact-links {
    display: grid;
    gap: 9px;
  }

  a {
    width: fit-content;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 620;
    line-height: 1.4;
    text-decoration: none;
  }

  a:first-child {
    font-size: 0.94rem;
  }

  a:hover {
    color: var(--color-accent-bright);
  }

  a:focus-visible {
    outline: 2px solid var(--color-accent-bright);
    outline-offset: 4px;
  }

  a > span:not(.external) {
    overflow-wrap: anywhere;
  }

  .external {
    color: var(--color-accent-bright);
  }

  p {
    max-width: 230px;
    margin: 15px 0 0;
    color: #65738a;
    font-size: 0.67rem;
    line-height: 1.55;
  }
</style>
