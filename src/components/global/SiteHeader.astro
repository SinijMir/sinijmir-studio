---
import DesktopNavigation from './DesktopNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';
---

<header class="site-header" aria-label="Основная навигация">
  <a class="brand" href="/" aria-label="SinijMir Studio — главная">
    <span class="brand-mark" aria-hidden="true">
      <img
        src="/branding/sinijmir-mark-160.png"
        alt=""
        width="40"
        height="40"
        decoding="async"
      />
    </span>
    <span>SinijMir <strong>Studio</strong></span>
  </a>

  <DesktopNavigation />
  <MobileNavigation />
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand strong {
    color: var(--color-accent-bright);
    font-weight: 600;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    display: block;
    overflow: hidden;
    border: 1px solid rgba(102, 179, 255, 0.42);
    border-radius: 12px;
    background: #02040d;
    box-shadow: 0 10px 35px rgba(33, 136, 255, 0.26);
  }

  .brand-mark img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 560px) {
    .site-header {
      min-height: 58px;
    }
  }
</style>
