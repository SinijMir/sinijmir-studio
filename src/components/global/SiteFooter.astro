---
import FooterLegalLinks from './FooterLegalLinks.astro';
import { telegramContact } from '../../config/contact';
import { navigationItems } from '../../config/navigation';

const currentYear = new Date().getFullYear();
const homeHref = import.meta.env.BASE_URL;
const logoUrl = `${homeHref}branding/sinijmir-mark-160.png`;
const directions = ['Мобильные приложения', 'Telegram-боты', 'AI-интеграции', 'Автоматизация'];
---

<footer class="site-footer">
  <div class="footer-inner">
    <section class="footer-cta" aria-labelledby="footer-cta-title">
      <div>
        <p>Новый проект / сотрудничество</p>
        <h2 id="footer-cta-title">Сильный цифровой продукт начинается с разговора.</h2>
      </div>

      <a
        href={telegramContact.href}
        target="_blank"
        rel="noreferrer"
      >
        Написать в Telegram
        <span aria-hidden="true">↗</span>
      </a>
    </section>

    <div class="footer-main">
      <div class="brand-column">
        <a class="brand" href={homeHref} aria-label="SinijMir Studio — главная">
          <span class="brand-mark" aria-hidden="true">
            <img
              src={logoUrl}
              alt=""
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span>SinijMir <strong>Studio</strong></span>
        </a>
        <p>Разработка мобильных приложений, серверных решений и AI-интеграций.</p>
      </div>

      <nav class="footer-column" aria-label="Навигация в подвале">
        <p class="column-label">Навигация</p>
        <ul>
          {navigationItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-column">
        <p class="column-label">Направления</p>
        <ul class="directions-list">
          {directions.map((direction) => <li>{direction}</li>)}
        </ul>
      </div>

      <div class="footer-column contact-column">
        <p class="column-label">Контакт</p>
        <a href={telegramContact.href} target="_blank" rel="noreferrer">
          {telegramContact.handle}
          <span aria-hidden="true">↗</span>
        </a>
        <p>Первое обсуждение проекта — в Telegram.</p>
      </div>
    </div>

    <div class="footer-wordmark" aria-hidden="true">SinijMir</div>

    <div class="footer-bottom">
      <p>© {currentYear} SinijMir Studio</p>
      <FooterLegalLinks />
      <a href="#top">
        Наверх
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 12% 20%, rgba(33, 136, 255, 0.14), transparent 28rem),
      #04060b;
  }

  .footer-inner {
    width: min(calc(100% - 48px), var(--container));
    margin: 0 auto;
    padding: clamp(72px, 10vw, 126px) 0 28px;
  }

  .footer-cta {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) auto;
    gap: 42px;
    align-items: end;
    padding-bottom: clamp(64px, 9vw, 110px);
    border-bottom: 1px solid var(--color-border);
  }

  .footer-cta p {
    margin: 0 0 24px;
    color: var(--color-accent-bright);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 5.8rem);
    font-weight: 560;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .footer-cta > a {
    min-width: 224px;
    padding: 16px 19px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 999px;
    color: #fff;
    background: var(--color-accent);
    box-shadow: 0 18px 54px rgba(33, 136, 255, 0.25);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
  }

  .footer-cta > a:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .footer-cta > a:focus-visible,
  .footer-column a:focus-visible,
  .footer-bottom a:focus-visible,
  .brand:focus-visible {
    outline: 2px solid var(--color-accent-bright);
    outline-offset: 4px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(240px, 1.3fr) repeat(3, minmax(130px, 0.7fr));
    gap: clamp(32px, 6vw, 80px);
    padding: clamp(54px, 8vw, 92px) 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--color-text);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .brand strong {
    color: var(--color-accent-bright);
    font-weight: 600;
  }

  .brand-mark {
    width: 48px;
    height: 48px;
    display: block;
    overflow: hidden;
    border: 1px solid rgba(102, 179, 255, 0.4);
    border-radius: 14px;
    background: #02040d;
    box-shadow: 0 14px 38px rgba(33, 136, 255, 0.2);
  }

  .brand-mark img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .brand-column > p {
    max-width: 280px;
    margin: 22px 0 0;
    color: #718098;
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .column-label {
    margin: 0 0 22px;
    color: #65738a;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column a,
  .directions-list li {
    color: #b7c4d5;
    font-size: 0.75rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .footer-column a:hover {
    color: var(--color-accent-bright);
  }

  .directions-list li {
    color: #7b899e;
  }

  .contact-column > a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 620;
  }

  .contact-column > a span {
    color: var(--color-accent-bright);
  }

  .contact-column > p:last-child {
    max-width: 180px;
    margin: 15px 0 0;
    color: #65738a;
    font-size: 0.67rem;
    line-height: 1.55;
  }

  .footer-wordmark {
    margin-left: -0.06em;
    color: rgba(247, 249, 252, 0.92);
    font-size: clamp(5rem, 17.2vw, 12.8rem);
    font-weight: 690;
    letter-spacing: -0.095em;
    line-height: 0.72;
    white-space: nowrap;
  }

  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
    margin-top: 54px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    color: #65738a;
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom a {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #8997ab;
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: var(--color-accent-bright);
  }

  @media (max-width: 900px) {
    .footer-cta {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .footer-cta > a {
      width: min(100%, 280px);
    }

    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .footer-inner {
      width: min(calc(100% - 32px), var(--container));
    }

    .footer-main,
    .footer-bottom {
      grid-template-columns: 1fr;
    }

    .footer-main {
      gap: 42px;
    }

    .footer-bottom {
      gap: 12px;
    }

    .footer-bottom a {
      justify-self: start;
    }
  }
</style>
