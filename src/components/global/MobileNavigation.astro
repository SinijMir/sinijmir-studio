---
import { contactLink, navigationItems } from '../../config/navigation';
---

<details class="mobile-menu">
  <summary aria-label="Открыть меню" aria-expanded="false">
    <span class="menu-icon" aria-hidden="true">
      <span></span>
      <span></span>
    </span>
  </summary>

  <button class="menu-backdrop" type="button" aria-label="Закрыть меню" tabindex="-1"></button>

  <nav class="menu-panel" aria-label="Мобильная навигация">
    <p class="menu-label">Навигация</p>
    <ol>
      {navigationItems.map((item, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ol>

    <a class="mobile-contact" href={contactLink.href}>
      {contactLink.label}
      <span aria-hidden="true">↗</span>
    </a>
  </nav>
</details>

<script>
  const setupMobileMenus = () => {
    document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
      if (menu.dataset.ready === 'true') return;
      menu.dataset.ready = 'true';

      const summary = menu.querySelector('summary');
      const backdrop = menu.querySelector<HTMLButtonElement>('.menu-backdrop');
      const links = menu.querySelectorAll('a');

      const closeMenu = (restoreFocus = false) => {
        menu.removeAttribute('open');
        if (restoreFocus) summary?.focus();
      };

      menu.addEventListener('toggle', () => {
        const isOpen = menu.open;
        summary?.setAttribute('aria-expanded', String(isOpen));
        summary?.setAttribute('aria-label', isOpen ? 'Закрыть меню' : 'Открыть меню');
        document.documentElement.classList.toggle('mobile-menu-open', isOpen);
      });

      backdrop?.addEventListener('click', () => closeMenu(true));
      links.forEach((link) => link.addEventListener('click', () => closeMenu()));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.open) closeMenu(true);
      });

      window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
        if (event.matches && menu.open) closeMenu();
      });
    });
  };

  setupMobileMenus();
</script>

<style>
  .mobile-menu {
    display: none;
  }

  summary {
    position: relative;
    z-index: 102;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 13px;
    background: rgba(12, 18, 31, 0.9);
    cursor: pointer;
    list-style: none;
    transition: border-color 180ms ease, background 180ms ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  summary:focus-visible {
    border-color: rgba(102, 179, 255, 0.58);
    background: var(--color-accent-soft);
  }

  summary:focus-visible {
    outline: 2px solid var(--color-accent-bright);
    outline-offset: 3px;
  }

  .menu-icon {
    width: 18px;
    height: 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
  }

  .menu-icon span {
    width: 18px;
    height: 1px;
    display: block;
    background: var(--color-text);
    transition: transform 180ms ease;
  }

  .mobile-menu[open] .menu-icon span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .mobile-menu[open] .menu-icon span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .menu-backdrop {
    position: fixed;
    z-index: 99;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(2, 4, 10, 0.74);
    backdrop-filter: blur(8px);
    cursor: default;
  }

  .menu-panel {
    position: fixed;
    z-index: 101;
    top: 82px;
    right: 16px;
    left: 16px;
    padding: 24px;
    border: 1px solid rgba(102, 179, 255, 0.22);
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 90% 0%, rgba(33, 136, 255, 0.16), transparent 17rem),
      rgba(8, 12, 22, 0.98);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.46);
  }

  .menu-label {
    margin: 0 0 12px;
    color: var(--color-accent-bright);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  li > span {
    color: #65738a;
    font-size: 0.62rem;
    font-weight: 700;
  }

  li a {
    padding: 16px 0;
    color: var(--color-text);
    font-size: clamp(1.1rem, 5vw, 1.35rem);
    font-weight: 570;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  li a:focus-visible {
    outline: 2px solid var(--color-accent-bright);
    outline-offset: 3px;
  }

  .mobile-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 22px;
    padding: 15px 18px;
    border-radius: 999px;
    color: #fff;
    background: var(--color-accent);
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
  }

  :global(html.mobile-menu-open) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .mobile-menu,
    summary {
      display: grid;
    }
  }
</style>
