---
import { contactLink, navigationItems } from '../../config/navigation';
---

<nav class="desktop-navigation" aria-label="Основная навигация">
  <ul>
    {navigationItems.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>

  <a class="contact-link" href={contactLink.href}>
    {contactLink.label}
    <span aria-hidden="true">↗</span>
  </a>
</nav>

<style>
  .desktop-navigation {
    display: flex;
    align-items: center;
    gap: clamp(24px, 3vw, 46px);
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.2vw, 34px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    position: relative;
    padding: 10px 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 180ms ease;
  }

  ul a::after {
    position: absolute;
    right: 0;
    bottom: 4px;
    left: 0;
    height: 1px;
    background: var(--color-accent-bright);
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  ul a:hover,
  ul a:focus-visible {
    color: var(--color-text);
  }

  ul a:hover::after,
  ul a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 11px 15px;
    border: 1px solid rgba(102, 179, 255, 0.35);
    border-radius: 999px;
    color: var(--color-text);
    background: rgba(33, 136, 255, 0.08);
    font-size: 0.76rem;
    font-weight: 650;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .contact-link:hover {
    border-color: rgba(102, 179, 255, 0.66);
    background: rgba(33, 136, 255, 0.16);
    transform: translateY(-1px);
  }

  .contact-link:focus-visible,
  ul a:focus-visible {
    outline: 2px solid var(--color-accent-bright);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .desktop-navigation {
      display: none;
    }
  }
</style>
