---
import { analyticsConfig } from '../../config/analytics';

const counterId = analyticsConfig.yandexMetrika.counterId;
---

<!-- Yandex.Metrika counter -->
<script define:vars={{ counterId }}>
  (function (m, e, t, r, i, k, a) {
    m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
    m[i].l = 1 * new Date();
    for (var j = 0; j < document.scripts.length; j += 1) {
      if (document.scripts[j].src === r) return;
    }
    k = e.createElement(t);
    a = e.getElementsByTagName(t)[0];
    k.async = 1;
    k.src = r;
    a.parentNode.insertBefore(k, a);
  })(window, document, 'script', `https://mc.yandex.ru/metrika/tag.js?id=${counterId}`, 'ym');

  ym(counterId, 'init', {
    ssr: true,
    clickmap: true,
    referrer: document.referrer,
    url: location.href,
    accurateTrackBounce: true,
    trackLinks: true,
  });

  window.sinijmirReachGoal = function (goal) {
    if (typeof goal !== 'string' || !goal.trim()) return;
    ym(counterId, 'reachGoal', goal.trim());
  };

  document.addEventListener('click', function (event) {
    var source = event.target instanceof Element ? event.target : null;
    var target = source ? source.closest('[data-metrika-goals]') : null;
    var goalList = target ? target.getAttribute('data-metrika-goals') : '';

    if (!goalList) return;
    goalList.split(/\s+/).forEach(window.sinijmirReachGoal);
  });
</script>
<noscript>
  <div>
    <img
      src={`https://mc.yandex.ru/watch/${counterId}`}
      style="position: absolute; left: -9999px;"
      alt=""
    />
  </div>
</noscript>
<!-- /Yandex.Metrika counter -->
