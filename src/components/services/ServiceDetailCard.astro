---
import type { Service } from '../../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const serviceHref = service.href ? `${import.meta.env.BASE_URL}${service.href.replace(/^\//, '')}` : null;
---

<article class:list={['service-detail', `service-detail--${service.accent}`]}>
  <div class="service-head">
    <span>{service.number}</span>
    <i aria-hidden="true"></i>
  </div>

  <div class="service-copy">
    <h2>{service.title}</h2>
    <p>{service.description}</p>
    {serviceHref && (
      <a class="service-link" href={serviceHref}>Подробнее о направлении <span aria-hidden="true">↗</span></a>
    )}
  </div>

  <div class="service-details">
    <div>
      <h3>Что входит</h3>
      <ul>
        {service.deliverables.map((deliverable) => <li>{deliverable}</li>)}
      </ul>
    </div>
    <div>
      <h3>Подходит для</h3>
      <p>{service.bestFor}</p>
    </div>
  </div>

  <ul class="technology-list" aria-label={`Технологии направления ${service.title}`}>
    {service.technologies.map((technology) => <li>{technology}</li>)}
  </ul>
</article>

<style>
  .service-detail {
    --service-color: var(--color-accent-bright);
    min-width: 0;
    padding: clamp(26px, 4vw, 46px);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(150deg, rgba(17, 24, 41, 0.86), rgba(7, 10, 18, 0.94));
  }

  .service-detail--cyan {
    --service-color: #43dcff;
  }

  .service-detail--violet {
    --service-color: #8d7dff;
  }

  .service-detail--indigo {
    --service-color: #6078ff;
  }

  .service-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--service-color);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.11em;
  }

  .service-head i {
    width: 9px;
    height: 9px;
    border: 1px solid currentColor;
    border-radius: 50%;
    box-shadow: 0 0 18px color-mix(in srgb, var(--service-color) 56%, transparent);
  }

  .service-copy {
    margin: 56px 0 40px;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 580;
    letter-spacing: -0.055em;
  }

  .service-copy p {
    max-width: 590px;
    margin: 18px 0 0;
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 1.72;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    color: var(--service-color);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
  }

  .service-link:hover,
  .service-link:focus-visible {
    color: var(--color-text);
  }

  .service-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: auto;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  h3 {
    margin: 0 0 15px;
    color: #738198;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-details li,
  .service-details p {
    margin: 0;
    color: #bdcad9;
    font-size: 0.76rem;
    line-height: 1.65;
  }

  .service-details li + li {
    margin-top: 6px;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 30px;
  }

  .technology-list li {
    padding: 7px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: #7f8da2;
    font-size: 0.61rem;
    font-weight: 650;
  }

  @media (max-width: 620px) {
    .service-details {
      grid-template-columns: 1fr;
    }
  }
</style>
